+// two co-op copies on one PC share the controllers: the one in the background neither reads nor drives them
+bool CoopBackground() {
+    return app::Instance() && coop::Networked() && GetForegroundWindow() != static_cast<HWND>(app::Window());
+}
+
 // port 0 has the keyboard; the game sees no input while the panel is open
 void Pad(int port, input::Pad& pad) {
+    if (coop::control::Override(port, pad)) return;  // a test copy plays the control channel's pad
+    if (CoopBackground()) {
+        // the keyboard's poll still sees the window inactive: the click that brings it in front is not taken
+        if (port == 0) {
+            input::Pad unused;
+            input::Keyboard(unused);
+        }
+        pad = input::Pad{.connected = port == 0 || pad.connected};
+        return;
+    }
     input::SeenPad(pad);
+    coop::PadRescue(port, pad.buttons);  // co-op: L3 + R3 held, before the keyboard's C and RMB join them
     if (port == 0) pad.connected = true;
     if (app::MenuOpen()) pad = input::Pad{.connected = pad.connected};
     else if (port == 0) input::Keyboard(pad);
+    // co-op, down: A, a click, Space or the right arrow watches the next living partner, the left arrow the one before
+    uint16_t watch = pad.buttons;
+    if (port == 0 && !app::MenuOpen()) {
+        auto key = [](int vk) { return (GetAsyncKeyState(vk) & 0x8000) != 0; };
+        if (key(VK_LBUTTON) || key(VK_SPACE) || key(VK_RIGHT)) watch |= 0x1000;
+        if (key(VK_LEFT)) watch |= 0x0004;
+    }
+    coop::life::PadWatch(port, watch);
 }
 
 // no vibration while the keyboard and mouse are in use
 void Rumble(int port, uint16_t& left, uint16_t& right) {
+    if (CoopBackground()) {
+        left = 0;
+        right = 0;
+        return;
+    }
     if (port != 0 || !input::KeyboardActive()) return;
     left = 0;
     right = 0;
