@@ -0,0 +1,55 @@
+// Sprint: the sprint key (Shift) held while moving forward on the keyboard, the player goes sprint_speed percent of
+// its run. The player's body is +0xA0 (the last row of its matrix), which the frame's update takes as it is at its
+// start; there, before it, the step the player made in the last frame is lengthened, so collisions stop it as they
+// stop the run (a step against a wall is no step).
+#include <cstdint>
+
+#include "common/mouse_keyboard.h"
+#include "common/options.h"
+#include "game/layout.h"
+#include "kernel/kernel.h"
+
+using namespace kernel;
+
+namespace {
+
+constexpr uint32_t kPlayerFeet = 0xA0;
+constexpr uint32_t kPlayerCrouch = 0x3A1;
+constexpr uint32_t kPlayerState = 0x384;  // 0 alive
+constexpr float kStepMax = 0.5f;          // longer in a frame: a teleport or a respawn, not a step
+
+bool g_forced = false;  // the test channel's "sprint 1"
+
+}  // namespace
+
+namespace sprint {
+
+void Force(bool on) { g_forced = on; }
+
+
+void Tick() {
+    static float last[3];
+    static bool have = false;
+    uint32_t world = R32(layout::kWorld);
+    if (!world) {
+        have = false;
+        return;
+    }
+    uint32_t p = world + layout::kWorldPlayer;
+    float& x = G<float>(p + kPlayerFeet);
+    float& z = G<float>(p + kPlayerFeet + 8);
+    float extra = float(game::Opt().sprint_speed) / 100.0f - 1.0f;
+    if (have && extra > 0 && (input::Sprinting() || g_forced) && R32(p + kPlayerState) == 0 &&
+        !G<uint8_t>(p + kPlayerCrouch)) {
+        float dx = x - last[0], dz = z - last[2];
+        float d2 = dx * dx + dz * dz;
+        if (d2 > 1e-8f && d2 < kStepMax * kStepMax) {
+            x += dx * extra;
+            z += dz * extra;
+        }
+    }
+    last[0] = x, last[2] = z;
+    have = true;
+}
+
+}  // namespace sprint
